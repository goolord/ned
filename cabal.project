-- The SDL backend needs SDL3, SDL3_ttf and pkg-config. On Windows install
-- them through MSYS2 UCRT64 and point PKG_CONFIG_PATH at
-- C:\msys64\ucrt64\lib\pkgconfig (see README.md).
package nano-ui-sdl
  flags: +sdl +simd
